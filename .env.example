# توکن ربات از @BotFather
TELEGRAM_BOT_TOKEN=

# آدرس عمومی سرویس (برای ساخت لینک دانلود)
# مثال روی سرور: https://dl.example.com
# مثال لوکال: http://127.0.0.1:38471
PUBLIC_BASE_URL=http://127.0.0.1:38471

# پورت سرور HTTP
PORT=38471

# اختیاری: فقط این یوزرآیدی‌های تلگرام اجازه آپلود دارند (با ویرگول)
# خالی = همه می‌توانند فایل بفرستند
ALLOWED_USER_IDS=

# حداکثر حجم فایل به بایت (پیش‌فرض ۲۰ مگابایت — محدودیت Bot API)
MAX_FILE_BYTES=20971520

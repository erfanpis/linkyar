# توکن ربات از @BotFather
TELEGRAM_BOT_TOKEN=

# --- فضای ابری GitHub (پیشنهادی، بدون VPS) ---
# در GitHub Actions خودش GITHUB_TOKEN و GITHUB_REPOSITORY تزریق می‌شود.
# برای تست لوکال یک PAT با مجوز contents:write بگذار:
GITHUB_TOKEN=
# مثال: username/linkyar
GITHUB_REPOSITORY=
GITHUB_BRANCH=main
GITHUB_UPLOAD_DIR=uploads
STORAGE_BACKEND=auto

# اختیاری: فقط این یوزرآیدی‌ها اجازه آپلود دارند
ALLOWED_USER_IDS=

# حداکثر حجم (پیش‌فرض ۲۰MB — محدودیت Bot API تلگرام)
MAX_FILE_BYTES=20971520

# --- فقط اگر بخواهی سرور لوکال هم بالا باشد ---
PORT=38471
PUBLIC_BASE_URL=http://127.0.0.1:38471
